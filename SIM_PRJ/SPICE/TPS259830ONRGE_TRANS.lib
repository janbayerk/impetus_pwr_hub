.SUBCKT AND2_BASIC_GEN_CB A B Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 
E_ABMGATE    YINT 0 VALUE {{IF(V(A) > {VTHRESH}  &  
+ V(B) > {VTHRESH},{VDD},{VSS})}}
RINT YINT Y 1
CINT Y 0 1n
.ENDS AND2_BASIC_GEN_CB
*$
.SUBCKT AND3_BASIC_GEN_CB A B C Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 
E_ABMGATE    YINT 0 VALUE {{IF(V(A) > {VTHRESH}  &  
+ V(B) > {VTHRESH} &
+ V(C) > {VTHRESH},{VDD},{VSS})}}
RINT YINT Y 1
CINT Y 0 1n
.ENDS AND3_BASIC_GEN_CB
*$
.SUBCKT INV_BASIC_GEN_CB A  Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 
E_ABMGATE    YINT 0 VALUE {{IF(V(A) > {VTHRESH} , 
+ {VSS},{VDD})}}
RINT YINT Y 1
CINT Y 0 1n
.ENDS INV_BASIC_GEN_CB
*$
.SUBCKT OR2_BASIC_GEN_CB A B Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 
E_ABMGATE    YINT 0 VALUE {{IF(V(A) > {VTHRESH}  |  
+ V(B) > {VTHRESH},{VDD},{VSS})}}
RINT YINT Y 1
CINT Y 0 1n
.ENDS OR2_BASIC_GEN_CB
*$
* CB variant: diode-free latch (linear 10 ohm pull while S/R active, see header)
.SUBCKT SRLATCHRHP_BASIC_GEN_CB S R Q QB PARAMS: VDD=1 VSS=0 VTHRESH=0.5 
GQ 0 Qint VALUE = {IF(V(R) > {VTHRESH},(({VSS})-V(Qint))*0.1,IF(V(S)>{VTHRESH},(({VDD})-V(Qint))*0.1,0))}
CQint Qint 0 1n
RQint Qint 0 1000MEG
V1 MY5 0 {VDD}
V2 MYVSS 0 {VSS} 
EQ Qqq 0 Qint 0 1
X3 Qqq Qqqd1 BUF_BASIC_GEN_CB PARAMS: VDD={VDD} VSS={VSS} VTHRESH={VTHRESH}
RQq Qqqd1 Q 1
EQb Qbr 0 VALUE = {IF( V(Q) > {VTHRESH}, {VSS},{VDD})}
RQb Qbr QB 1 
Cdummy1 Q 0 1n 
Cdummy2 QB 0 1n
.IC V(Qint) {VSS}
.ENDS SRLATCHRHP_BASIC_GEN_CB
*$
.SUBCKT INV_DELAY_BASIC_GEN_CB A  Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 DELAY = 10n 
E_ABMGATE1    YINT1 0 VALUE {{IF(V(A) > {VTHRESH} , 
+ {VDD},{VSS})}}
RINT YINT1 YINT2 1
CINT YINT2 0 {DELAY*1.3}
* CB variant: continuous threshold on the slow RC node
E_ABMGATE2    YINT3 0 VALUE { {VSS}+({VDD}-{VSS})*0.5*(1-tanh((V(YINT2)-{VTHRESH})*1e5)) }
RINT2 YINT3 Y 1
CINT2 Y 0 1n
.ENDS INV_DELAY_BASIC_GEN_CB
*$
.MODEL D_D1_CB D (IS = 1E-15 Rs = 50m N = 0.1 TT = 10p)
*$
.SUBCKT BUF_DELAY_BASIC_GEN_CB A  Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 DELAY = 10n 
E_ABMGATE1    YINT1 0 VALUE {{IF(V(A) > {VTHRESH} , 
+ {VDD},{VSS})}}
RINT YINT1 YINT2 1
CINT YINT2 0 {DELAY*1.3}
* CB variant: continuous threshold on the slow RC node
E_ABMGATE2    YINT3 0 VALUE { {VSS}+({VDD}-{VSS})*0.5*(1+tanh((V(YINT2)-{VTHRESH})*1e5)) }
RINT2 YINT3 Y 1
CINT2 Y 0 1n
.ENDS BUF_DELAY_BASIC_GEN_CB
*$
.SUBCKT BUF_BASIC_GEN_CB A  Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 
E_ABMGATE    YINT 0 VALUE {{IF(V(A) > {VTHRESH} , 
+ {VDD},{VSS})}}
RINT YINT Y 1
CINT Y 0 1n
.ENDS BUF_BASIC_GEN_CB
*$
.SUBCKT COMP_BASIC_GEN_CB INP INM Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5	
* CB variant: continuous comparator (tanh, 10 uV) for ngspice convergence
E_ABM Yint 0 VALUE { {VSS} + ({VDD}-{VSS})*0.5*(1+tanh((V(INP)-V(INM))*1e5)) }
R1 Yint Y 1
C1 Y 0 1n
.ENDS COMP_BASIC_GEN_CB
*$
.MODEL NMOS01_CB NMOS (VTO = 1.4 KP = 2400 LAMBDA = 0.001)
.MODEL D_SOFT_CB D (IS=1E-15 N=1 RS=1)
*$
.SUBCKT NAND2_BASIC_GEN_CB A B Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 
E_ABMGATE    YINT 0 VALUE {{IF(V(A) > {VTHRESH}  &  
+ V(B) > {VTHRESH},{VSS},{VDD})}}
RINT YINT Y 1
CINT Y 0 1n
.ENDS NAND2_BASIC_GEN_CB
*$
.SUBCKT ONE_SHOT_CB IN OUT
+ PARAMs:  T=100
* CB variant: rebuilt one-shot (rising edge of IN -> pulse of T*1ns), no algebraic latch loop
E_ABM1         CH 0 VALUE { if( V(IN)>0.5 | V(QI)>0.5,1,0)    }
R_R1         MEAS CH  {T} 
C_C1         0 MEAS  1.4427n  
G_DIS        MEAS 0 VALUE { if( V(CH)<0.5, V(MEAS), 0) }
E_DONE       DONE 0 VALUE { 0.5*(1+tanh((V(MEAS)-0.5)*1e5)) }
G_Q          0 QI VALUE { if( V(DONE)>0.5, -V(QI)*0.1, if( V(IN)>0.5, (1-V(QI))*0.1, 0)) }
C_Q          QI 0 1n
R_Q          QI 0 1G
E_ABM3         OUT 0 VALUE { if( V(QI)>0.5, 1-V(DONE), 0) }
.IC V(QI)=0
.ENDS ONE_SHOT_CB
*$
* CB variant: diode-free latch (linear 10 ohm pull while S/R active, see header)
.SUBCKT SRLATCHSHP_BASIC_GEN_CB S R Q QB PARAMS: VDD=1 VSS=0 VTHRESH=0.5 
GQ 0 Qint VALUE = {IF(V(S) > {VTHRESH},(({VDD})-V(Qint))*0.1,IF(V(R)>{VTHRESH},(({VSS})-V(Qint))*0.1,0))}
CQint Qint 0 1n
RQint Qint 0 1000MEG
V1 MY5 0 {VDD}
V2 MYVSS 0 {VSS} 
EQ Qqq 0 Qint 0 1
X3 Qqq Qqqd1 BUF_BASIC_GEN_CB PARAMS: VDD={VDD} VSS={VSS} VTHRESH={VTHRESH}
RQq Qqqd1 Q 1
EQb Qbr 0 VALUE = {IF( V(Q) > {VTHRESH}, {VSS},{VDD})}
RQb Qbr QB 1 
Cdummy1 Q 0 1n 
Cdummy2 QB 0 1n 
.IC V(Qint) {VSS}
.ENDS SRLATCHSHP_BASIC_GEN_CB
*$
.SUBCKT D_MODE_CB 1 2
D1 1 2 DD1
.MODEL DD1 D (IS = 1e-5 Rs = 10m N = 2.317)
.ENDS D_MODE_CB
*$
.SUBCKT COMPHYS_BASIC_GEN_CB INP INM HYS OUT PARAMS: VDD=1 VSS=0 VTHRESH=0.5	 
EIN INP1 INM1 INP INM 1  
EHYS INP1 INP2 VALUE { IF( V(1) > {VTHRESH},-V(HYS),0) } 
* CB variant: continuous comparator (tanh, 10 uV) for ngspice convergence
EOUT OUT 0 VALUE { {VSS} + ({VDD}-{VSS})*0.5*(1+tanh((V(INP2)-V(INM1))*1e5)) } 
R1 OUT 1 1 
C1 1 0 5n 
RINP1 INP1 0 1K 
.ENDS COMPHYS_BASIC_GEN_CB 
*$
.SUBCKT OR3_BASIC_GEN_CB A B C Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 
E_ABMGATE    YINT 0 VALUE {{IF(V(A) > {VTHRESH}  |  
+ V(B) > {VTHRESH} |
+ V(C) > {VTHRESH},{VDD},{VSS})}}
RINT YINT Y 1
CINT Y 0 1n
.ENDS OR3_BASIC_GEN_CB
*$
.SUBCKT NOR2_BASIC_GEN_CB A B Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 
E_ABMGATE    YINT 0 VALUE {{IF(V(A) > {VTHRESH}  |  
+ V(B) > {VTHRESH},{VSS},{VDD})}}
RINT YINT Y 1
CINT Y 0 1n
.ENDS NOR2_BASIC_GEN_CB
*$
.SUBCKT NAND3_BASIC_GEN_CB A B C Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5 
E_ABMGATE    YINT 0 VALUE {{IF(V(A) > {VTHRESH}  &  
+ V(B) > {VTHRESH} &
+ V(C) > {VTHRESH},{VSS},{VDD})}}
RINT YINT Y 1
CINT Y 0 1n
.ENDS NAND3_BASIC_GEN_CB
*$



.SUBCKT BFET_CB DRAIN GATE SOURCE  
M_M2         DRAIN GATE SOURCE SOURCE Q1_CB           
C_C4         SOURCE GATE  4262p  
C_C1         GATE DRAIN  238p  
D_D1_CB         SOURCE DRAIN D_D1_CB 
C_C3         SOURCE DRAIN  214pF  
.ENDS


