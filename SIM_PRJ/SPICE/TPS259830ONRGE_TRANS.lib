X_U2_U111         U2_N17794741 U2_IFAST_ST_CTL BUF_BASIC_GEN_CB PARAMS: VDD=1
+  VSS=0 VTHRESH=0.5
X_U2_S3    0 0 U2_VOUT_INT DVDT/BGATE MOS_U2_S3_CB 
X_U2_U126         U2_N18190734 U2_N18190771 INV_BASIC_GEN_CB PARAMS: VDD=1 VSS=0
+  VTHRESH=500E-3
V_U2_V22         U2_IFAST_TH 0 35
X_U2_S10    U2_C 0 N16900450 0 MOS_U2_S10_CB 
X_U2_U114         N17045771 THERMAL_OK U2_N17863938 OR2_BASIC_GEN_CB PARAMS: VDD=1 VSS=0
+  VTHRESH=500E-3
V_U2_V10         U2_N17513227 VIN 10
R_U2_V10LOAD         U2_N17513227 VIN 10k
X_U2_S1    U2_N17513979 0 PG U2_N17512741 MOS_U2_S1_CB 
E_U2_E4         U2_N18081501 0 N16900450 0 1
* CB variant: VIN sample cap charged from an internal copy of VIN (no IN pin current)
E_U2_VINCOPY      U2_VIN_COPY 0 VIN 0 1
X_U2_S9    U2_N18042902 0 U2_VIN_COPY U2_VIN_S MOS_U2_S9_CB 
X_U2_U133         U2_N18534784 U2_CTRL U2_N18397090 AND2_BASIC_GEN_CB PARAMS:
+  VDD=1 VSS=0 VTHRESH=500E-3
D_U2_D8         U2_N17794741 U2_N17737817 D_D1_CB 
X_U2_U105         U2_IFAST_ST_CTL U2_N17729253 ONE_SHOT_CB PARAMS:  T=500  
C_U2_C3         U2_GATE U2_N17512963  800p  
.ENDS
* ngspice: the PSpice VSWITCH switches are mapped to XSPICE devices, which makes
* ngspice tighten trtol to 1 for the whole circuit -> very small timesteps / stalls.
* xtrtol=7 restores the ngspice default.
* METHOD=GEAR: the logic gates of this model are 1 ohm/1 nF stages (tau=1 ns) with
* us timesteps; trapezoidal integration rings on them and can flip internal latches
* (spurious faults, lost retries, hangs). The model is validated with gear.
* Both are GLOBAL options for the whole simulation.
.OPTIONS XTRTOL=7 METHOD=GEAR

